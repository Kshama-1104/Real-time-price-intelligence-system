NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=price_intelligence
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_SIZE=10
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/price_intelligence

REDIS_HOST=localhost
REDIS_PORT=6379
