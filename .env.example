REDIS_TTL_SECONDS=45
# REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOG_LEVEL=info

NGINX_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
